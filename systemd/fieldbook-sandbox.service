[Unit]
Description=Fieldbook sandbox network namespace
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# These paths are populated by the privileged installation step as root-owned
# 0755 files; never execute mutable repository files from a root unit.
ExecStart=/usr/local/libexec/fieldbook-sandbox-setup
ExecStop=/usr/local/libexec/fieldbook-sandbox-teardown
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
